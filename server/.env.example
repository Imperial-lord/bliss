# =========================================================================
# Bliss Signaling & Cinema Server Environment Variables Template
# Copy this file to .env and customize as needed.
# =========================================================================

# Port for Express & Socket.IO server
PORT=5001

# Allowed Cross-Origin Resource Sharing (CORS) origins (comma-separated)
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional: OCI Object Storage S3-Compatible Configuration (Always Free 20GB)
OCI_BUCKET_NAME=bliss-cinema-cache
OCI_NAMESPACE=your_oci_tenancy_namespace
OCI_REGION=ap-hyderabad-1
OCI_COMPAT_ENDPOINT=https://your_oci_tenancy_namespace.compat.objectstorage.ap-hyderabad-1.oraclecloud.com
OCI_ACCESS_KEY=your_oci_customer_secret_key_access_id
OCI_SECRET_KEY=your_oci_customer_secret_key
