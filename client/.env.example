# =========================================================================
# Bliss Client Environment Variables Template
# Copy this file to .env and configure your Firebase Web App credentials.
# =========================================================================

# Firebase Web App Credentials (obtain from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Custom Signaling Server URL (defaults to window.location.origin in production or http://localhost:5001 in dev)
# VITE_SERVER_URL=https://your-domain.com
